# Delta themes (only active/used themes)
# See: https://github.com/dandavison/delta/blob/main/themes.gitconfig

[delta "side-by-side"]
    side-by-side = true

[delta "collared-trogon"]
    # author: https://github.com/clnoll
    commit-decoration-style = bold box ul
    dark = true
    file-decoration-style = none
    file-style = omit
    hunk-header-decoration-style = "#022b45" box ul
    hunk-header-file-style = "#999999"
    hunk-header-line-number-style = bold "#003300"
    hunk-header-style = file line-number syntax
    line-numbers = true
    line-numbers-left-style = "#022b45"
    line-numbers-minus-style = "#80002a"
    line-numbers-plus-style = "#003300"
    line-numbers-right-style = "#022b45"
    line-numbers-zero-style = "#999999"
    minus-emph-style = normal "#80002a"
    minus-style = normal "#330011"
    plus-emph-style = syntax "#003300"
    plus-style = syntax "#001a00"
    syntax-theme = Nord

# Match tuicr's bundled Catppuccin Mocha diff palette.
[delta "tuicr-catppuccin-mocha"]
    dark = true
    true-color = always
    syntax-theme = Catppuccin Mocha

    # tuicr uses 16% accent blends for syntax-highlighted diff rows and
    # 20% blends for its stronger add/delete backgrounds.
    plus-style = syntax "#333d40"
    plus-non-emph-style = syntax "#333d40"
    plus-emph-style = syntax "#394545"
    minus-style = syntax "#402f41"
    minus-non-emph-style = syntax "#402f41"
    minus-emph-style = syntax "#483346"
    zero-style = syntax

    line-numbers = true
    line-numbers-plus-style = "#a6e3a1"
    line-numbers-minus-style = "#f38ba8"
    line-numbers-zero-style = "#6c7086"
    line-numbers-left-style = "#45475a"
    line-numbers-right-style = "#45475a"

    hunk-header-style = "#6c7086" "#303040"
    hunk-header-decoration-style = none
    file-style = bold "#cdd6f4"
    file-decoration-style = none
