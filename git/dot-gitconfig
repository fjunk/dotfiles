# Shared git config (managed via dotfiles / stow)

[include]
    path = ~/.gitconfig.local # Private settings (name, email, etc.) go in ~/.gitconfig.local

[include]
    path = ~/.config/git/delta-themes.gitconfig # Color theme

[push]
    autoSetupRemote = true

[core]
    pager = delta
    excludesfile = ~/.gitignore_global

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    features = collared-trogon side-by-side

[merge]
    conflictStyle = zdiff3
[init]
	defaultBranch = main
