# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME='arrow'

plugins=(git)

# Docker CLI completions (must be before oh-my-zsh compinit)
fpath=($HOME/.docker/completions $fpath)

source $ZSH/oh-my-zsh.sh

# Source all shared config files 
if [[ -d "$HOME/.zshrc-shared.d" ]]; then
  for conf in "$HOME/.zshrc-shared.d/"*.zsh(N); do
    source "$conf"
  done
fi

# Source all local config files (machine-specific)
if [[ -d "$HOME/.zshrc.d" ]]; then
  for conf in "$HOME/.zshrc.d/"*.zsh(N); do
    source "$conf"
  done
fi
