# Source all shared config files 
if [[ -d "$HOME/.zshrc-shared.d" ]]; then
  for conf in "$HOME/.zshrc-shared.d/"*.zsh(N); do
    source "$conf"
  done
fi

# Source all local config files (machine-specific)
if [[ -d "$HOME/.zshrc.d" ]]; then
  for conf in "$HOME/.zshrc.d/"*.zsh(N); do
    source "$conf"
  done
fi

export XDG_CONFIG_HOME="$HOME/.config"
export ZELLIJ_LAYOUT_DIR="$HOME/.config/zellij/layouts"

eval "$(zoxide init zsh)"
eval "$(starship init zsh)"

# Bind ctrl-r but not up arrow
eval "$(atuin init zsh --disable-up-arrow)"
