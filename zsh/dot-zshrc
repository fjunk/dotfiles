# ~/.zshrc
#
# Keep this file intentionally small. Shared, versioned shell setup lives in
# ~/.zshrc-shared.d/*.zsh; private machine-specific overrides live in
# ~/.zshrc.d/*.zsh and are sourced last.

_source_zsh_dir() {
  local dir="$1"
  local conf

  [[ -d "$dir" ]] || return
  for conf in "$dir"/*.zsh(N); do
    source "$conf"
  done
}

_source_zsh_dir "$HOME/.zshrc-shared.d"
_source_zsh_dir "$HOME/.zshrc.d"

unset -f _source_zsh_dir

# set g alias (override git plugin g alias)
alias g=lazygit
